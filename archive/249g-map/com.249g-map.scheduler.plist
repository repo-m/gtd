<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.249g-map.scheduler</string>

	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>/Users/hm13/m/gtd/archive/249g-map/scheduler.sh</string>
	</array>

	<key>WorkingDirectory</key>
	<string>/Users/hm13/m/gtd/archive/249g-map</string>

	<!-- Every 6 hours (21600s). RunAtLoad also fires one immediately on
	     install; launchd catches up a missed interval as soon as the Mac
	     is awake again rather than skipping it outright. -->
	<key>StartInterval</key>
	<integer>21600</integer>

	<key>RunAtLoad</key>
	<true/>

	<key>StandardOutPath</key>
	<string>/Users/hm13/m/gtd/archive/249g-map/.scheduler/launchd.out.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/hm13/m/gtd/archive/249g-map/.scheduler/launchd.err.log</string>

	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/Users/hm13/.local/bin:/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
		<key>HOME</key>
		<string>/Users/hm13</string>
	</dict>
</dict>
</plist>
